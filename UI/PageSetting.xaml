<UserControl x:Class="He_Thong_Diem_Danh_Qr.UI.PageSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:He_Thong_Diem_Danh_Qr.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="White">
    <Grid>
        <Border Width="350"
        Height="400"
        Background="#2C3E50"
        CornerRadius="20">
            <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <TextBlock Text="Đổi mật khẩu"
                   FontSize="25"
                   FontWeight="SemiBold"
                   Foreground="White"
                   TextAlignment="Center"
                   Margin="0,0,0,20"/>
                <TextBlock Text="Mật khẩu cũ"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="15,0,0,5"/>
                <TextBox x:Name="txtPasswordold"
                 Width="300"
                 Height="45"
                 FontSize="16"
                 Margin="0,2,0,25"
                 Style="{StaticResource RoundedTextBox}"/>
                <TextBlock Text="Mật khẩu mới"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="15,0,0,5" Width="303"/>
                <TextBox x:Name="txtPasswordnew"
                 Width="300"
                 Height="45"
                 FontSize="16"
                 Margin="0,2,0,25"
                 Style="{StaticResource RoundedTextBox}"/>
                <TextBlock Text="Nhập lại mật khẩu mới"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Margin="15,0,0,5"/>
                <TextBox x:Name="txtPasswordnewss"
                 Width="300"
                 Height="45"
                 FontSize="16"
                 Style="{StaticResource RoundedTextBox}"/>
                <Button 
                x:Name="btn_xacnhan"    
                Content="Xác Nhận"
                Width="100"
                Height="30"
                Margin="20"
                Background="#1ABC9C"
                HorizontalContentAlignment="Center"
                Style="{StaticResource SidebarButtonStyle}"
                Click="btn_xacnhan_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
