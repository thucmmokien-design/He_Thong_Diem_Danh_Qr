<UserControl x:Class="He_Thong_Diem_Danh_Qr.UI.PageQuanLyChuyenCan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:He_Thong_Diem_Danh_Qr.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
        Background="#2C3E50">
            <TextBlock HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Text="Quản Lý Chuyên Cần"
               FontSize="24"
               FontWeight="Bold"
               Foreground="White"/>
        </Border>
        <Border Grid.Row="1"
                Background="White">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Lớp Học Phần:" VerticalAlignment="Center"/>
                <ComboBox x:Name="comboBoxHocPhan2"
                  DisplayMemberPath="class_id"
                  SelectedValuePath="class_id"        
                  Width="60"
                  Margin="10,0,10,0"/>
                <TextBlock x:Name="txtMonHoc"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Tên Sinh Viên :" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="inputhoten" 
                         Width="97" VerticalAlignment="Center" />
                <TextBlock Text="Đóng góp buổi học:" Margin="12,0,12,0" VerticalAlignment="Center"/>
                <TextBox x:Name="inputdonggop"
                         Width="97" VerticalAlignment="Center" />
                <TextBlock Text="Điểm Chuyên Cần:" Margin="12,0,12,0" VerticalAlignment="Center"/>
                <TextBox x:Name="inputdiemcuyencan" 
                         Width="97" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="Đánh Giá Học Phần:" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBox x:Name="inputdanhgiahoctap"
                         Width="97" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="btnTimKiem"
                        Width="25"
                        Cursor="Hand"
                        Margin="12,0,12,0"
                        Click="btnTimKiem_Click">
                    <Image Source="/UI/search-12-24.png"/>
                </Button>
                <Button x:Name="btnupdate"
                        Width="25"
                        Cursor="Hand"
                        Click="btnupdate_Click">
                    <Image Source="/UI/upload-3-24.png"/>
                </Button>
            </StackPanel>
        </Border>
        <Border Grid.Row="2"
                Background="White">
            <Grid>
                <DataGrid x:Name="dsChuyenCan"
                          Margin="2"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên sinh viên"
                                            Width="200"
                                            Binding="{Binding hoten}"/>
                        <DataGridTextColumn Header="Msv"
                                            Width="70"
                                            Binding="{Binding msv}"/>
                        <DataGridTextColumn Header="Lớp Học Phần"
                                            Width="100"
                                            Binding="{Binding class_id}"/>
                        <DataGridTextColumn Header="Đóng Góp Trong Học Tập"
                                            Width="150"
                                            Binding="{Binding so_lan_len_bang}"/>
                        <DataGridTextColumn Header="Số Buổi Vắng"
                                            Width="100"
                                            Binding="{Binding tong_so_buoi_vang}"/>
                        <DataGridTextColumn Header="Điểm Chuyên Cần"
                                            Width="120"
                                            Binding="{Binding diem_chuyen_can}"/>
                        <DataGridTextColumn Header="Ghi Chú"
                                            Width="*"
                                            Binding="{Binding ghi_chu}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
