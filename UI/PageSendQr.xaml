<UserControl x:Class="He_Thong_Diem_Danh_Qr.UI.PageSendQr"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:He_Thong_Diem_Danh_Qr.UI"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#2C3E50">
            <TextBlock Text="Hệ Thống Điểm Danh QR"
                         FontSize="24"
                         FontWeight="Bold"
                         Foreground="White"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
        </Border>
        <TextBlock Grid.Row="1"
                   Grid.Column="1" 
                   TextWrapping="Wrap" 
                   Text="Hãy Quét Tôi" 
                   FontSize="20"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0" 
                   Height="26" 
                   Width="114"/>
        <Border Grid.Row="1"
                Grid.Column="1"
                BorderThickness="1"
                BorderBrush="Gray"
                Margin="91,50,90,20">
            <Image x:Name="qrImage"
                   Stretch="Uniform"/>
        </Border>
        <Border Grid.Row="1"
                Grid.Column="0"
                BorderThickness="1"
                BorderBrush="Gray">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>
                <TextBlock  x:Name="txtNameGiaoVien"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            FontSize="30"
                            Grid.Row="0"
                           />
                <StackPanel Orientation="Horizontal" Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="Lớp Học Phần :"  FontSize="25" Width="179" Height="32"/>
                    <ComboBox x:Name="ComboxLhp"
                              DisplayMemberPath="class_id"
                              SelectionChanged="comboBoxHocPhan_SelectionChanged"
                              Width="155"
                              Height="32"
                              Margin="0,0,12,0"/>
                </StackPanel>
                <TextBlock x:Name="txtTenMonHoc"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Center"
                           FontSize="25"
                           Grid.Row="2"/>
                <Button Grid.Row="3"
                        x:Name="btnsendqr"
                        HorizontalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Style="{StaticResource SidebarButtonStyle}"
                        FontSize="27"
                        Content="Tạo Mã Qr "
                        Background="Red"
                        Width="141"
                        Height="40" Margin="0,39,0,37"
                        Click="btnsendqr_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>