<UserControl x:Class="He_Thong_Diem_Danh_Qr.UI.PageQuanLySinhVien"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:He_Thong_Diem_Danh_Qr.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="#2C3E50">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="Quản Lý Buổi Học"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="White"/>
        </Border>
        <Border Grid.Row="1" Background="White">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Chọn Lớp Học Phần: " VerticalAlignment="Center"/>
                <ComboBox x:Name="comboBoxHocPhan"
                  DisplayMemberPath="class_id"
                  SelectedValuePath="ten_mon"
                  SelectionChanged="comboBoxHocPhan_SelectionChanged"        
                  Width="60"
                  Margin="10,0,10,0"/>
                <TextBlock x:Name="txtMonHoc"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Chọn Trạng Thái Sinh Viên Đến Lớp : " VerticalAlignment="Center"/>
                <ComboBox x:Name="comboBoxBuoiHoc"
                          Width="120"
                          Margin="10,0,10,0">
                    <ComboBoxItem Content="Đã Điểm Danh" Tag="DD"/>
                    <ComboBoxItem Content="Vắng" Tag="V"/>
                </ComboBox>
                <TextBlock Text="Load Bảng:"  VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="btnLoad"
                        Width="20"
                        Click="btnLoad_Click">
                    <Image Source="/UI/pngegg.png"/>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="White">
            <Grid>
                <DataGrid x:Name="dgSinhVien"
                          AutoGenerateColumns="False"
                          Margin="2"
                          CanUserAddRows="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tên sinh viên"
                                Binding="{Binding hoten}"
                                Width="200"/>
                        <DataGridTextColumn Header="Msv"
                                Binding="{Binding msv}"
                                Width="70"/>
                        <DataGridTextColumn Header="Lớp học phần"
                                Binding="{Binding class_id}"
                                Width="120"/>
                        <DataGridTextColumn Header="Email"
                                Binding="{Binding email}"
                                Width="150"/>
                        <DataGridTextColumn Header="Thời Gian Điểm Danh"
                                Binding="{Binding checkin_time}"
                                Width="200"/>
                        <DataGridTextColumn Header="Trạng Thái"
                                Binding="{Binding status}"
                                Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
